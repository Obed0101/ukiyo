    <ProjectReference Include="../../src/Ukiyo.Core/Ukiyo.Core.csproj" />
    <ProjectReference Include="../../src/Ukiyo.Physics/Ukiyo.Physics.csproj" />
    <ProjectReference Include="../../src/Ukiyo.UI/Ukiyo.UI.csproj" />
    <ProjectReference Include="../../src/Ukiyo.Audio/Ukiyo.Audio.csproj" />
    <ProjectReference Include="../../src/Ukiyo.Render.Null/Ukiyo.Render.Null.csproj" />
    <ProjectReference Include="../../src/Ukiyo.Render.Software/Ukiyo.Render.Software.csproj" />
    <ProjectReference Include="../../src/Ukiyo.DevBridge/Ukiyo.DevBridge.csproj" />
  </ItemGroup>
</Project>
