# Build output
bin/
obj/
artifacts/
*.user
.DS_Store

# Pinned native dependencies are fetched/built by scripts/fetch-native.sh. No trailing slash: worktrees link
# native/ or native/osx-arm64 to the main checkout, and a pattern ending in / does not match a symlink.
/native

# JS dependencies and synced web assets (no trailing slash, for the same reason)
node_modules
samples/*/Browser/wwwroot/lib/
games/*/Browser/wwwroot/lib/
**/Www/lib/

# MCP sprite tool scratch output (generated sprites land in the game's Shared/assets instead)
.ukiyo/

# Local tool state
.mendcode/
