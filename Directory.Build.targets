<Project>
  <!--
    Source identity: every host that links a game's Shared/ records the SHA-256 of those files as
    assembly metadata (ukiyo.source:<file>). Desktop, web and headless runs print them, so parity
    evidence can prove all targets compiled the same Program.cs and game code. Files in a subfolder of
    the glob keep their relative path in the key (Scenes/Level.cs), so two files with one name never collide.
  -->
  <Target Name="UkiyoSharedSourceHash" BeforeTargets="GetAssemblyAttributes" Condition="'@(UkiyoSharedSource)' != ''">
    <ItemGroup>
      <_UkiyoKeyedSource Include="@(UkiyoSharedSource)" UkiyoSourceKey="$([System.String]::Copy('%(UkiyoSharedSource.RecursiveDir)').Replace('\','/'))%(UkiyoSharedSource.Filename)%(UkiyoSharedSource.Extension)" />
    </ItemGroup>
    <GetFileHash Files="@(_UkiyoKeyedSource)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_UkiyoHashedSource" />
    </GetFileHash>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ukiyo.source:%(_UkiyoHashedSource.UkiyoSourceKey)</_Parameter1>
        <_Parameter2>%(_UkiyoHashedSource.FileHash)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!--
    Game folder: hosts of the template layout (templates/game, docs/game-layout.md) live in <game>/Hosts/<Host>/ and
    set UkiyoGameDir; the older layout (<game>/<Host>/) gets the parent folder.
    Game assets: everything under the game's Shared/assets folder is embedded as "assets/<relative path>", read at
    runtime through GameContext.Assets. Same bytes on desktop, web and headless; exports stay single-file. Dot files
    (.gitkeep, .DS_Store) are not assets.
  -->
  <PropertyGroup>
    <UkiyoGameDir Condition="'$(UkiyoGameDir)' == ''">$(MSBuildProjectDirectory)/../</UkiyoGameDir>
    <UkiyoSharedAssetsDir>$(UkiyoGameDir)Shared/assets/</UkiyoSharedAssetsDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(UkiyoSharedAssetsDir)')">
    <EmbeddedResource Include="$(UkiyoSharedAssetsDir)**/*" Exclude="$(UkiyoSharedAssetsDir)**/.*" LogicalName="assets/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Dev bridge: development hosts set UkiyoDevBridge=true. They link the bridge library and a module initializer that
    registers it with DevHooks. Export profiles never set it, so shipped games contain no listener or agent code.
  -->
  <ItemGroup Condition="'$(UkiyoDevBridge)' == 'true'">
    <ProjectReference Include="$(UkiyoRoot)src/Ukiyo.DevBridge/Ukiyo.DevBridge.csproj" />
    <Compile Include="$(UkiyoRoot)src/Ukiyo.DevBridge/Registration/DevBridgeRegistration.cs" Link="DevBridgeRegistration.cs" />
  </ItemGroup>

  <!--
    Browser hosts: the adapter, the shared shell and the pinned three build are copied into <web root>/lib. The web
    root is the project's wwwroot/ unless the host sets UkiyoWebRoot (the template layout uses <game>/Www/); its files
    are then linked into the project as wwwroot/<relative path>, so build, run and publish serve them unchanged.
  -->
  <PropertyGroup Condition="'$(UkiyoBrowserHost)' == 'true'">
    <UkiyoWebRoot Condition="'$(UkiyoWebRoot)' == ''">wwwroot/</UkiyoWebRoot>
    <_UkiyoLinkedWebRoot Condition="'$(UkiyoWebRoot)' != 'wwwroot/'">true</_UkiyoLinkedWebRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(_UkiyoLinkedWebRoot)' == 'true'">
    <Content Include="$(UkiyoWebRoot)**" Exclude="$(UkiyoWebRoot)lib/**;$(UkiyoWebRoot)**/.*" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" ContentRoot="$(UkiyoWebRoot)" />
  </ItemGroup>
  <Target Name="UkiyoSyncWebAdapter" BeforeTargets="BeforeBuild" Condition="'$(UkiyoBrowserHost)' == 'true'">
    <PropertyGroup>
      <UkiyoAdapterDir>$(UkiyoRoot)web/three-adapter/</UkiyoAdapterDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(UkiyoAdapterDir)node_modules/three/build/three.module.js')" Text="three is not installed. Run: (cd web/three-adapter &amp;&amp; bun install)" />
    <ItemGroup>
      <_UkiyoAdapter Include="$(UkiyoAdapterDir)protocol.js;$(UkiyoAdapterDir)ukiyo-three.js;$(UkiyoAdapterDir)sprite-geometry.js;$(UkiyoAdapterDir)lit-material.js;$(UkiyoAdapterDir)ukiyo-host.js" />
      <_UkiyoThree Include="$(UkiyoAdapterDir)node_modules/three/build/three.module.js;$(UkiyoAdapterDir)node_modules/three/build/three.core.js" />
    </ItemGroup>
    <Copy SourceFiles="@(_UkiyoAdapter)" DestinationFolder="$(UkiyoWebRoot)lib/" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_UkiyoThree)" DestinationFolder="$(UkiyoWebRoot)lib/three/" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Include="wwwroot/lib/**" Exclude="@(Content)" Condition="'$(_UkiyoLinkedWebRoot)' != 'true'" />
      <_UkiyoWebLib Include="$(UkiyoWebRoot)lib/**" Exclude="@(Content)" Condition="'$(_UkiyoLinkedWebRoot)' == 'true'" />
      <Content Include="@(_UkiyoWebLib)" Link="wwwroot/lib/%(_UkiyoWebLib.RecursiveDir)%(_UkiyoWebLib.Filename)%(_UkiyoWebLib.Extension)" ContentRoot="$(UkiyoWebRoot)" />
    </ItemGroup>
  </Target>
</Project>
