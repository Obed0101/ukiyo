<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless host: no window, no GPU. Snapshots and CPU captures for agents and tests (docs/game-layout.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>my-game-headless</AssemblyName>
    <RootNamespace>Ukiyo.Games.MyGame</RootNamespace>
    <!-- The game folder: Directory.Build.targets embeds its Shared/assets from here. -->
    <UkiyoGameDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))</UkiyoGameDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Everything under Shared/ compiles into every host and is hashed into the source identity. -->
    <UkiyoSharedSource Include="$(UkiyoGameDir)Shared/**/*.cs" />
    <Compile Include="@(UkiyoSharedSource)" Link="Shared/%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="$(UkiyoRoot)src/Ukiyo.Platform.Headless/Ukiyo.Platform.Headless.csproj" />
  </ItemGroup>
</Project>
